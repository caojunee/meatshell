import { Theme } from "theme.slint";

// Shared chrome for the detached auxiliary windows (process monitor, system
// information, editor): draggable title bar, optional save action, crisp frame
// and the bottom-right resize grip. Callers insert their body via @children;
// the body should set `vertical-stretch: 1` so it fills the area below the bar.
export component AuxWindowChrome inherits Rectangle {
    in property <string> title-text;
    in property <string> subtitle;          // "" hides the muted suffix
    in property <bool> show-titlebar: true;  // false on macOS (native chrome)
    in property <bool> show-close: true;
    in property <bool> show-save: false;
    in property <string> save-label: @tr("Save");
    in property <bool> show-grip: true;

    callback dragged();                     // start an OS window move
    callback closed();
    callback saved();
    callback resize-started();              // start an OS resize from the corner

    background: transparent;

    VerticalLayout {
        width: 100%;
        height: 100%;
        spacing: 0;

        // --- Title bar ----------------------------------------------------
        if root.show-titlebar : Rectangle {
            height: 42px;
            background: Theme.bg-panel-alt;

            Rectangle {
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: Theme.border-subtle;
            }

            drag-ta := TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.dragged();
                    }
                }
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 10px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 16px;
                        height: 16px;
                    }
                }

                Text {
                    text: root.title-text;
                    color: Theme.text-primary;
                    font-size: Theme.fs-md;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    color: Theme.text-muted;
                    font-size: Theme.fs-sm;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle { horizontal-stretch: 1; }

                if root.show-save : Rectangle {
                    width: 64px;
                    height: 26px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: save-ta.has-hover ? Theme.accent-hover : Theme.accent;
                    save-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.saved(); }
                    }
                    Text {
                        text: root.save-label;
                        color: #ffffff;
                        font-size: Theme.fs-sm;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.show-close : Rectangle {
                    width: 40px;
                    height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius-sm;
                    background: close-ta.has-hover ? #e81123 : transparent;
                    animate background { duration: 90ms; }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.closed(); }
                    }
                    Text {
                        text: "\u{E5CD}";
                        font-family: "Material Icons";
                        color: close-ta.has-hover ? #ffffff : Theme.text-secondary;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // --- Caller body ---------------------------------------------------
        @children
    }

    // --- Window frame ------------------------------------------------------
    // Only frameless windows need the drawn edge; native-chrome platforms get
    // the real OS border and shadow.
    if root.show-titlebar : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: 8px;
    }

    // --- Bottom-right resize grip -----------------------------------------
    if root.show-grip : Rectangle {
        width: 16px;
        height: 16px;
        x: parent.width - self.width;
        y: parent.height - self.height;

        grip-ta := TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.resize-started();
                }
            }
        }

        Rectangle { x: parent.width - 5px;  y: parent.height - 5px;  width: 2px; height: 2px;
                    background: Theme.text-muted; }
        Rectangle { x: parent.width - 9px;  y: parent.height - 5px;  width: 2px; height: 2px;
                    background: Theme.text-muted; }
        Rectangle { x: parent.width - 5px;  y: parent.height - 9px;  width: 2px; height: 2px;
                    background: Theme.text-muted; }
    }
}
